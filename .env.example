# Leak does NOT read the OpenRouter API key from this file (plaintext). Store it in
# the OS keychain with `leak llm key set`, or, for CI/containers/headless use, export
# OPENROUTER_API_KEY in the real environment from your secret store.

# Optional model overrides (OpenRouter ids). Leave empty to use config.toml.
OPENROUTER_MODEL_EXTRACT=
OPENROUTER_MODEL_REASON=

# Optional: passwords for password-protected statement PDFs, comma-separated.
LEAK_PDF_PASSWORDS=
